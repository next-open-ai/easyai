{
  "name": "@next-open-ai/easyai",
  "version": "0.3.12",
  "private": false,
  "description": "Cross-platform local AI workspace.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-open-ai/easyai.git"
  },
  "packageManager": "pnpm@10.20.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "easyai": "./bin/easyai.mjs"
  },
  "files": [
    "bin",
    "apps/api/dist",
    "apps/renderer/dist",
    "scripts/start-web.mjs",
    "scripts/lib",
    "README.md",
    "README.zh-CN.md",
    "apps/gateway/package.json",
    "apps/gateway/dist",
    "packages/channel/package.json",
    "packages/channel/dist"
  ],
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.1",
    "@lancedb/lancedb": "0.22.3",
    "@larksuiteoapi/node-sdk": "^1.11.1",
    "@easyai/channel": "file:./packages/channel",
    "apache-arrow": "18.1.0",
    "fastify": "^5.3.0",
    "sql.js": "^1.14.2",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @easyai/desktop dev",
    "web:build": "pnpm build",
    "web:start": "node scripts/start-web.mjs",
    "easyai:start": "node bin/easyai.mjs start",
    "easyai:init": "node bin/easyai.mjs init",
    "easyai:doctor": "node bin/easyai.mjs doctor",
    "build": "pnpm --filter @easyai/contracts build && pnpm --filter @easyai/tools build && pnpm --filter @easyai/storage build && pnpm --filter @easyai/channel build && pnpm --filter @easyai/gateway build && pnpm --filter @easyai/agent-core build && pnpm --filter @easyai/orchestrator build && pnpm --filter @easyai/api build && pnpm --filter @easyai/renderer build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "package": "pnpm --filter @easyai/desktop package",
    "size:check": "node scripts/check-size.mjs",
    "orch:smoke": "node scripts/headless-gateway-smoke.mjs",
    "orch:remote-confirm": "node scripts/remote-project-confirm.mjs",
    "orch:remote-chat": "node scripts/remote-chat.mjs",
    "gateway:stub": "node scripts/gateway-stub-smoke.mjs",
    "gateway:config": "node scripts/gateway-config.mjs",
    "gateway:feishu": "node scripts/gateway-feishu-smoke.mjs",
    "gateway:relay": "node scripts/relay-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "ws": "^8.18.0"
  }
}
